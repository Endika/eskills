{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh",
            "statusMessage": "Loading eskills precedence"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ai-tells.py",
            "if": "Bash(git *)",
            "timeout": 5,
            "statusMessage": "Checking prose for generated-text tells"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ai-tells.py",
            "if": "Bash(gh *)",
            "timeout": 5,
            "statusMessage": "Checking prose for generated-text tells"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/code-tells.py",
            "if": "Bash(git *)",
            "timeout": 5,
            "statusMessage": "Checking the staged diff for generated-code tells"
          }
        ]
      }
    ]
  }
}
